/* Ready-to-use NOVA texture menu.
   Requires ItemsAdder or Oraxen and the generated client resource pack. */
screen {
    title: "NOVA Dashboard";
    rows: 6;
    texture-provider: auto;
    texture-image: "mcss:mcss_dashboard";
    title-oraxen: "<glyph:mcss_dashboard>";
    title-offset: 0;
    texture-offset: 0;
    background: AIR;
    hide-buttons: true;
}

/* Each visible card is a 3x2 transparent click target.
   The coordinates align with the three artwork panels. */
.play {
    slot: 27;
    hitbox: 3x2;
    item: DIAMOND_SWORD;
    action: message:Play button clicked!;
}

.profile {
    slot: 30;
    hitbox: 3x2;
    item: PLAYER_HEAD;
    action: message:Profile button clicked!;
}

.settings {
    slot: 33;
    hitbox: 3x2;
    item: COMPARATOR;
    action: message:Settings button clicked!;
}

/* Small close tab in the last top-inventory row. */
.close {
    slot: 52;
    hitbox: 2x1;
    item: BARRIER;
    action: close;
}
