/* The default dashboard uses a custom 176x166 GUI artwork.
   Install ItemsAdder or Oraxen and apply the files from the setup folder. */
screen {
    title: "NOVA Dashboard";
    rows: 6;
    texture-provider: auto;
    texture-image: "mcss:mcss_dashboard";
    title-oraxen: "<shift:-16><glyph:mcss_dashboard>";
    background: AIR;
    hide-buttons: true;
}

.play {
    slot: 19;
    hitbox: 2x2;
    item: DIAMOND_SWORD;
    action: message:Play button clicked!;
}

.profile {
    slot: 22;
    hitbox: 2x2;
    item: PLAYER_HEAD;
    action: message:Profile button clicked!;
}

.settings {
    slot: 25;
    hitbox: 2x2;
    item: COMPARATOR;
    action: message:Settings button clicked!;
}

.close {
    slot: 49;
    hitbox: 2x1;
    item: BARRIER;
    action: close;
}
