/* Textured NOVA example.
   The large background image is registered as a font image/glyph
   in ItemsAdder or Oraxen. Click targets remain real Minecraft items. */
screen {
    title: "NOVA Dashboard";
    rows: 6;
    texture-provider: auto;

    /* Oraxen: register a glyph named mcss_dashboard */
    title-oraxen: "<shift:-16><glyph:mcss_dashboard>";

    /* ItemsAdder: register a font_image named mcss_dashboard */
    title-itemsadder: ":offset_-16::mcss_dashboard:";

    background: AIR;
    hide-buttons: true;
}

.play {
    slot: 20;
    item: DIAMOND_SWORD;
    render: hidden;
    action: command:spawn;
}

.profile {
    slot: 22;
    item: PLAYER_HEAD;
    render: hidden;
    action: open:profile;
}

.settings {
    slot: 24;
    item: COMPARATOR;
    render: hidden;
    action: open:settings;
}

.close {
    slot: 49;
    item: BARRIER;
    render: hidden;
    action: close;
}
