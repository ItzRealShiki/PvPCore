/* Default menu generated by Minecraft CSS Engine */
screen {
    title: "NOVA Dashboard";
    rows: 3;
    background: BLACK_STAINED_GLASS_PANE;
}

.play {
    slot: 11;
    material: DIAMOND_SWORD;
    text: "Play";
    color: #55ddff;
    lore: "Join the server|Click to continue";
    action: message:Welcome to the server, %player%!;
    glow: true;
}

.settings {
    slot: 13;
    material: COMPARATOR;
    text: "Settings";
    color: #a78bfa;
    lore: "Configure your experience";
    action: message:Settings menu example;
}

.close {
    slot: 15;
    material: BARRIER;
    text: "Close";
    color: #fb7185;
    lore: "Close this menu";
    action: close;
}
