/* Textured NOVA example.
   The GUI artwork is a font image/glyph rendered from the inventory title.
   Buttons are real Minecraft items kept in their normal inventory slots. */
screen {
    title: "NOVA Dashboard";
    rows: 6;
    texture-provider: auto;
    title-oraxen: "<shift:-16><glyph:mcss_dashboard>";
    title-itemsadder: ":offset_-16::mcss_dashboard:";
    background: AIR;
    hide-buttons: true;
}

.play {
    slot: 20;
    item: DIAMOND_SWORD;
    action: command:spawn;
}

.profile {
    slot: 22;
    item: PLAYER_HEAD;
    action: open:profile;
}

.settings {
    slot: 24;
    item: COMPARATOR;
    action: open:settings;
}

.close {
    slot: 49;
    item: BARRIER;
    action: close;
}
